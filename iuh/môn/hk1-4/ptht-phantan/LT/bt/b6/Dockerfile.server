# Multi-stage build cho ChatServer (Gọn nhẹ, an toàn, chuẩn môn PTHT IUH)
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /app
COPY ChatServer.java .
RUN javac -encoding UTF-8 ChatServer.java

# Stage runtime siêu nhẹ với JRE Alpine
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=builder /app/*.class .

ENV PORT=5000
EXPOSE 5000

ENTRYPOINT ["java", "ChatServer"]

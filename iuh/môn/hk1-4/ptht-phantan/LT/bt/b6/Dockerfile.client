# Multi-stage build cho ChatClient (Chuẩn Docker Desktop Windows/Linux)
FROM eclipse-temurin:21-jdk-alpine AS builder
WORKDIR /app
COPY ChatClient.java .
RUN javac -encoding UTF-8 ChatClient.java

# Stage runtime siêu nhẹ với JRE Alpine
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=builder /app/*.class .

# Mặc định trên Docker Desktop kết nối vào host.docker.internal (cổng Server đã map)
ENV SERVER_HOST=host.docker.internal
ENV SERVER_PORT=5000

ENTRYPOINT ["java", "ChatClient"]
